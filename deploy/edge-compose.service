# Brings the station (edge + mosquitto containers) up at boot, after Docker and the network.
# TEMPLATE: @USER@ / @REPO@ are filled in by the installer with your Pi username and the repo folder:
#   bash deploy/install_service.sh compose
# Containers also have restart: unless-stopped; this unit makes a fresh boot deterministic and rebuilds nothing.
[Unit]
Description=Edge inspection station (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/usr/bin/docker compose -f docker/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f docker/compose.yaml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
