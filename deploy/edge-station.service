# Alternative to Docker: run the station directly from the venv, restarted by systemd if it ever dies.
# TEMPLATE: @USER@ / @REPO@ are filled in by the installer with your Pi username and the repo folder:
#   bash deploy/install_service.sh station
# Crash test:  sudo systemctl kill -s USR1 edge-station   -> journalctl -u edge-station shows exit 70 + restart
# (Use EITHER this unit OR edge-compose.service, not both: they would fight over the camera and GPIO.)
[Unit]
Description=Edge inspection station (venv)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
Environment=EDGE_TARGET=pi
EnvironmentFile=-@REPO@/docker/.env
ExecStart=@REPO@/.venv/bin/python -m edgevision.app --dashboard --inspect
Restart=always
RestartSec=2
# GPIO / camera / I2C access
SupplementaryGroups=gpio video i2c

[Install]
WantedBy=multi-user.target
