# Alternative to Docker: run the station directly from the venv, restarted by systemd if it ever dies.
#   sudo cp deploy/edge-station.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now edge-station
# Crash test:  sudo systemctl kill -s USR1 edge-station   -> journalctl -u edge-station shows exit 70 + restart
# (Use EITHER this unit OR edge-compose.service, not both: they would fight over the camera and GPIO.)
[Unit]
Description=Edge inspection station (venv)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Edge_AI_Project
Environment=EDGE_TARGET=pi
EnvironmentFile=-/home/pi/Edge_AI_Project/docker/.env
ExecStart=/home/pi/Edge_AI_Project/.venv/bin/python -m edgevision.app --dashboard
Restart=always
RestartSec=2
# GPIO / camera / I2C access
SupplementaryGroups=gpio video i2c

[Install]
WantedBy=multi-user.target
